# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
GOOGLE_APPLICATION_CREDENTIALS=./path-to-service-account.json

# Vercel API (カスタムドメイン機能)
VERCEL_API_TOKEN=            # Vercel Dashboard → Settings → Tokens で取得
VERCEL_PROJECT_ID=           # Vercel Dashboard → Project → Settings → General で確認
VERCEL_TEAM_ID=              # チームプロジェクトの場合のみ必要

# Resend API (メール送信機能)
RESEND_API_KEY=              # https://resend.com/api-keys で取得

# OpenAI API
OPENAI_API_KEY=
# 未設定の用途はこのモデルにフォールバック（翻訳のデフォルトは gpt-4o-mini）
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# 翻訳（未設定時は OPENAI_DEFAULT_MODEL → gpt-4o-mini）
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# AI要約だけ別モデルにしたい場合（未設定時は翻訳モデルと同じ）
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# 記事スラッグ生成（未設定時は OPENAI_DEFAULT_MODEL → gpt-4o-mini）
# OPENAI_ARTICLE_SLUG_MODEL=gpt-4o-mini
# サイトインポート解析（未設定時は OPENAI_DEFAULT_MODEL → gpt-4o）
# OPENAI_SITE_IMPORT_MODEL=gpt-4o

# Algolia
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
ALGOLIA_ADMIN_API_KEY=

